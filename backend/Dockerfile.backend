FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv venv /app/.venv \
    && uv export --frozen --no-dev --no-hashes \
       | grep -Ev '^(torch|nvidia-|triton|cuda-|transformers|sentencepiece|onnxruntime)' > /tmp/req-core.txt \
    && uv pip install --python /app/.venv/bin/python --no-cache -r /tmp/req-core.txt

RUN uv export --frozen --no-dev --no-hashes \
       | grep -E '^(transformers|sentencepiece|onnxruntime)' > /tmp/req-ml.txt \
    && uv pip install --python /app/.venv/bin/python --no-cache -r /tmp/req-ml.txt

RUN uv pip install --python /app/.venv/bin/python --no-cache \
       --index-url https://download.pytorch.org/whl/cpu 'torch>=2.2,<3'

COPY app ./app
COPY alembic ./alembic
COPY alembic.ini ./

ENV PATH="/app/.venv/bin:$PATH"
ENV HF_HOME=/root/.cache/huggingface
ENV PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
